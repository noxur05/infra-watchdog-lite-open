TELOXIDE_TOKEN=your_bot_token_here
DATABASE_URL=sqlite:watchdog.db
RUST_LOG=info
CHECK_INTERVAL_SECS=120
NODE_FILTER=MLP
ALERT_ON_FIRST_CHECK=true
BOT_CODE=BWD
ADMIN_TELEGRAM_ID=0

# OpenVPN Access Server backend (the fixed exit the Selectel front DNATs to).
# The bot calls its REST API to point host.name at the current front IP.
OPENVPN_BACKEND_IP=
OPENVPN_API_USER=
OPENVPN_API_PASS=
OPENVPN_API_PORT=943

# SMTP relay for BCC-ing the email list when the front IP changes.
# Leave all blank to disable mailing (handled silently).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Symmetric key for the daily encrypted DB backup.
BACKUP_PASSWORD=
